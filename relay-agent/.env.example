# ==============================================================================
# MaraPlus On-Premise Relay Agent Environment Variables
# ==============================================================================

# Supabase Project Configuration (Find in Supabase Dashboard -> Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Service Role Key is required for backend workers to bypass Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Physical Local MaraPlus ERP Endpoint
MARAPLUS_BASE_URL="http://192.168.15.225:3002"
MARAPLUS_TIMEOUT_MS=8000

# Throttling & Rate Limiting Specifications
THROTTLE_DELAY_MS=300
BATCH_SIZE=10
INTER_BATCH_PAUSE_MS=2000

# Resiliency & Retries
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000

# Internal Monitoring / Healthcheck Server
PORT=3001
